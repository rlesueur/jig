# Copy to .env next to compose.yaml and uncomment what you need. Every setting is optional.

# Host port for the web UI and API (always on 127.0.0.1 unless you change JIG_BIND_ADDRESS).
# JIG_HOST_PORT=8766
# JIG_BIND_ADDRESS=127.0.0.1

# Model server. Default: a server on the host at port 8080.
# JIG_MODEL_BASE_URL=http://host.docker.internal:8080/v1
# With --profile ollama:
# JIG_MODEL_BASE_URL=http://ollama:11434/v1
# With --profile llamacpp:
# JIG_MODEL_BASE_URL=http://llamacpp:8080/v1
# Needed when the server offers more than one model:
# JIG_MODEL_NAME=
# Use Jig from your other devices: the host's tailnet name, after 'tailscale serve --bg --https=443
# http://127.0.0.1:8766' on the host (docs/container.md). Never use 'tailscale funnel'.
# JIG_REMOTE_HOSTNAME=machine.tailnet.ts.net

# Your own config instead of deploy/jig.toml:
# JIG_CONFIG_FILE=./jig.local.toml

# Vault key (a Docker secret). Never commit it.
# JIG_VAULT_KEY_PATH=./secrets/jig_vault_key

# Images (defaults are the published ones; `docker compose build` builds them locally).
# JIG_IMAGE=ghcr.io/rlesueur/jig:0.1.0
# JIG_SANDBOX_IMAGE=ghcr.io/rlesueur/jig-sandbox:0.1.0

# --profile llamacpp
# LLAMACPP_MODELS_DIR=./models
# LLAMACPP_ARGS=-m /models/your-model.gguf --host 0.0.0.0 --port 8080 --jinja --ctx-size 32768 --parallel 4 -ngl 999

# --profile ollama
# OLLAMA_CONTEXT_LENGTH=32768
